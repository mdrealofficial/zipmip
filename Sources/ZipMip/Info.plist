            </dict>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
                <string>public.data</string>
                <string>public.folder</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>ZipMip: Compress to 7Z (Ultra)</string>
            </dict>
            <key>NSMessage</key>
            <string>compressTo7zService</string>
            <key>NSPortName</key>
            <string>ZipMip</string>
            <key>NSRequiredContext</key>
            <dict>
                <key>NSTextContent</key>
                <string>FilePath</string>
            </dict>
